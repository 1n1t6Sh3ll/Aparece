{
  "manifest_version": 3,
  "name": "PowerLens Product Audit",
  "version": "0.1.0",
  "description": "Audit the product on the current page with the PowerLens extraction API.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "PowerLens audit" },
  "options_page": "options.html"
}
