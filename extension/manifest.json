{
  "manifest_version": 3,
  "name": "Aparece Listing Audit",
  "version": "0.2.0",
  "description": "Audit the shirt listing on the current page against similar shirts with the Aparece API.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Aparece audit" },
  "options_page": "options.html"
}
