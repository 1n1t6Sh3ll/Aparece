# Copy to .env and uncomment only what you set. Never commit .env or real keys.
# Empty values are not safe for numeric settings, so leave unused lines commented.

# API / extraction
# MODEL_BACKEND=            # rules (default) | qwen
# QWEN_ADAPTER_PATH=
# QWEN_BASE_MODEL=
# QWEN_TIMEOUT_S=
# QWEN_MAX_NEW=

# Dashboard data (missing files show empty states)
# PRODUCTLENS_DATA=         # normalized or ground-truth JSONL
# PRODUCTLENS_SIGNALS=      # signals/build.py output JSONL
# PRODUCTLENS_VISIBILITY=   # benchmark report.json
# PRODUCTLENS_EVAL=         # train/eval.py JSON

# Monitoring
# MONITOR_ENABLED=          # 1 starts the scheduler
# MONITOR_DB=
# MONITOR_DELAY=

# AI-visibility benchmark (paid providers need a key AND a spend cap)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# QWEN_BASE_URL=
# QWEN_API_KEY=
# BENCHMARK_MODELS=
# BENCHMARK_PROMPTS=
# BENCHMARK_REPEATS=
# BENCHMARK_MIN_INTERVAL=
# BENCHMARK_MAX_USD=
